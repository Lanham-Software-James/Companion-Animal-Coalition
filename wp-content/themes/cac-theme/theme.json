{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "layout": {
            "contentSize": "780px",
            "wideSize": "1280px"
        },
        "appearanceTools": false,
        "color": {
            "custom": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "customGradient": false,
            "palette": [
                {
                    "slug": "primary",
                    "color": "#7067C9",
                    "name": "Primary"
                },
                {
                    "slug": "primary-dark",
                    "color": "#51469B",
                    "name": "Primary Dark"
                },
                {
                    "slug": "cream",
                    "color": "#F5F3FC",
                    "name": "Soft Lavender"
                },
                {
                    "slug": "white",
                    "color": "#FFFFFF",
                    "name": "White"
                },
                {
                    "slug": "text",
                    "color": "#272139",
                    "name": "Text"
                }
            ]
        },
        "typography": {
            "defaultFontSizes": false,
            "customFontSize": true,
            "dropCap": false
        },
        "spacing": {
            "defaultSpacingSizes": false
        }
    }
}
